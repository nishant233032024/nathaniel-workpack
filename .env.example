# Postgres connection string used by the deployed backend.
#
# Leave this unset locally: with no DATABASE_URL the app uses data/fees.db
# (SQLite), which is the fastest way to run the portal on your own machine.
#
# On Vercel it is required, because the filesystem is ephemeral and read-only.
# Any Postgres works (Neon, Supabase, Vercel Postgres). Include sslmode=require
# for hosted providers.
DATABASE_URL=
